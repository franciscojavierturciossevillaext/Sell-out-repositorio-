# ─────────────────────────────────────────────────────────────
# Microsoft Azure / Entra ID – required for real SharePoint access
# ─────────────────────────────────────────────────────────────
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# ─────────────────────────────────────────────────────────────
# SharePoint / Graph settings
# ─────────────────────────────────────────────────────────────
# Site id can be found with:
#   GET https://graph.microsoft.com/v1.0/sites?search=<site-name>
SHAREPOINT_SITE_ID=your-site-id-here

# Drive id (optional) – if omitted the default document library drive is used.
# GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SHAREPOINT_DRIVE_ID=

# Default folder to list when folder_path is "root"
SHAREPOINT_ROOT_FOLDER=root

# ─────────────────────────────────────────────────────────────
# OpenAI (optional) – for LLM-based analysis in future phases
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
